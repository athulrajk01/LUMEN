# ============================================================
# LUMEN — Backend Environment Variables (TEMPLATE)
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=LUMEN
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://lumen:lumen@localhost:5432/lumen
# SQLite (dev fallback):
DATABASE_URL=sqlite:///./lumen.db

# --- Security ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_REAL_ENV
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# --- Reports ---
REPORTS_DIR=./reports_output

# --- Logging ---
LOG_LEVEL=INFO
